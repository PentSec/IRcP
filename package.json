{
  "name": "ircp",
  "version": "2.0.0-irc.63",
  "private": true,
  "type": "module",
  "description": "A Discord theme shaped like a terminal IRC client.",
  "homepage": "https://jeff.is-a.dev/IRcP/irc.theme.css",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PentSec/IRcP.git"
  },
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "bd-scss build && node scripts/postbuild.mjs",
    "reroll": "bd-scss reroll",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:cascade": "node scripts/verify-cascade.mjs"
  },
  "dependencies": {
    "bd-scss": "^3.0.8"
  },
  "devDependencies": {
    "postcss": "^8.5.31",
    "prettier": "^3.9.10"
  }
}
